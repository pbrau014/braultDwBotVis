# Isolated DWBOT development-bot configuration.
# Copy to .env locally; never commit .env or share its contents.
NODE_ENV=development
DISCORD_BOT_TOKEN=PASTE_TEST_BOT_TOKEN_HERE
TARGET_CHANNEL_ID=PASTE_TEST_CHANNEL_ID_HERE
TOURNAMENT_ADMIN_IDS=PASTE_TEST_ADMIN_USER_ID_HERE

# Isolated JSON storage: never point this at production tournament state.
TOURNAMENT_STORAGE=json
TOURNAMENT_STATE_PATH=./testdata/live-discord-state/tournament-state.json
TOURNAMENT_SQLITE_PATH=./testdata/live-discord-state/tournament-state.sqlite

ENABLE_SLASH_COMMANDS=0
ENABLE_DESKTOP_UI=0

# Remote OCR is OFF by default. Enable only for an explicitly approved run.
DWBOT_MULTI_PROVIDER_ENABLED=0
OCRSPACE_ENABLED=0
OCRSPACE_NETWORK_ALLOWLIST=0
OCRSPACE_API_KEY=
OCRSPACE_MAX_CROPS=2
OCRSPACE_STAGE_BUDGET_MS=20000
OCRSPACE_MAX_PER_DAY=450
OCRSPACE_MAX_PER_MONTH=22000
OCRSPACE_MAX_ENGINE3_PER_MONTH=900
OCRSPACE_QUOTA_PATH=./data/ocrspace-quota.json

AZURE_DOCUMENT_INTELLIGENCE_ENABLED=0
AZURE_DOCUMENT_INTELLIGENCE_NETWORK_ALLOWLIST=0
AZURE_DOCUMENT_INTELLIGENCE_TIER=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MAX_PER_MONTH=450
AZURE_DOCUMENT_INTELLIGENCE_QUOTA_PATH=./data/azure-document-intelligence-quota.json

# For a designated smoke run, set restriction=1 and provide this writable log.
OCR_NON_OCR_NETWORK_RESTRICTED=0
OCR_NON_OCR_NETWORK_LOG=./testdata/multi-provider-smoke/network-blocked-attempts.log

# Local readers and bounded one-image test settings.
OCR_ENGINE=tesseractjs
OCR_PARALLEL_READER_TIMEOUT_MS=60000
PADDLEOCR_FIELD_FALLBACK=0
PADDLEOCR_MODEL_MANIFEST=
OCR_CV_ASSIST=0
MAX_IMAGE_MB=10
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=12000
MAX_PENDING_OCR_JOBS=2
OCR_IMAGE_TIMEOUT_MS=90000
OCR_LANGUAGE=eng
SNAPSHOT_DEBOUNCE_MS=30000
