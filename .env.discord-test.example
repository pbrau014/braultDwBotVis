# Isolated DWBOT development-bot configuration.
# Copy to .env locally; never commit .env or share its contents.
NODE_ENV=development
DISCORD_BOT_TOKEN=PASTE_TEST_BOT_TOKEN_HERE
TARGET_CHANNEL_ID=PASTE_TEST_CHANNEL_ID_HERE
TOURNAMENT_ADMIN_IDS=PASTE_TEST_ADMIN_USER_ID_HERE

# Isolated JSON storage: do not point this at production tournament state.
TOURNAMENT_STORAGE=json
TOURNAMENT_STATE_PATH=./testdata/live-discord-state/tournament-state.json
TOURNAMENT_SQLITE_PATH=./testdata/live-discord-state/tournament-state.sqlite

# Keep production/global slash-command registration disabled. OCR.Space is a
# last-resort remote evidence provider after local OCR; default it off.
# Enable only for an authorized isolated synthetic-crop test after reviewing terms.
# Supply a Free-tier key locally; never commit a real key or .env file.
ENABLE_SLASH_COMMANDS=0
OCRSPACE_ENABLED=0
OCRSPACE_API_KEY=
OCRSPACE_MAX_CROPS=2
OCRSPACE_STAGE_BUDGET_MS=20000
OCRSPACE_MAX_PER_DAY=450
OCRSPACE_MAX_PER_MONTH=22000
OCRSPACE_MAX_ENGINE3_PER_MONTH=900
OCRSPACE_QUOTA_PATH=./data/ocrspace-quota.json
PADDLEOCR_FIELD_FALLBACK=0
OCR_CV_ASSIST=0

# Conservative image/OCR limits for a one-image smoke test.
MAX_IMAGE_MB=10
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=12000
MAX_PENDING_OCR_JOBS=2
OCR_IMAGE_TIMEOUT_MS=90000
OCR_LANGUAGE=eng
SNAPSHOT_DEBOUNCE_MS=30000
