# Optional DWBOT desktop browser interface.
# Disabled until a Discord OAuth2 application is configured locally.
ENABLE_DESKTOP_UI=0
DESKTOP_UI_PORT=8787

# Discord Developer Portal -> OAuth2 -> Redirects:
# http://127.0.0.1:8787/auth/discord/callback
# Requested OAuth scope: identify only.
# Keep the actual OAuth client secret in your local .env. Do not commit it.
DISCORD_OAUTH_CLIENT_ID=PASTE_DISCORD_OAUTH_CLIENT_ID_HERE
DISCORD_OAUTH_CLIENT_SECRET=PASTE_DISCORD_OAUTH_CLIENT_SECRET_HERE
DISCORD_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/auth/discord/callback

# Desktop admin access requires explicit Discord user IDs.
# Replace the example below with actual authorized admin IDs in local .env.
TOURNAMENT_ADMIN_IDS=123456789012345678
