# Optional DWBOT desktop browser interface.
# Disabled until a Discord OAuth2 application is configured locally.
ENABLE_DESKTOP_UI=0
DESKTOP_UI_PORT=8787

# Discord Developer Portal -> OAuth2 -> Redirects:
# http://127.0.0.1:8787/auth/discord/callback
# Requested OAuth scope: identify only.
# Keep the actual OAuth client secret in your local .env. Do not commit it.
DISCORD_OAUTH_CLIENT_ID=PASTE_DISCORD_OAUTH_CLIENT_ID_HERE
DISCORD_OAUTH_CLIENT_SECRET=PASTE_DISCORD_OAUTH_CLIENT_SECRET_HERE
DISCORD_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/auth/discord/callback

# Desktop admin access requires explicit Discord user IDs.
# Replace the example below with actual authorized admin IDs in local .env.
TOURNAMENT_ADMIN_IDS=123456789012345678

# OCR.Space Free API is the first OCR stage. Engine 2 receives each authorized source screenshot
# and creates a searchable PDF; all local OCR readers process the PDF-derived raster.
# Production requires OCRSPACE_API_KEY. Keep the actual key only in local .env or Actions secrets.
# OCRSPACE_ENABLED=0 is an explicit local-only development/test override, never a production fallback.
# Upload authorization is limited to the 4-, 16- and 64-image World of Warships inventories.
OCRSPACE_ENABLED=1
OCRSPACE_API_KEY=
OCRSPACE_PDF_FIRST_TIMEOUT_MS=45000
OCRSPACE_MAX_PER_DAY=450
OCRSPACE_MAX_PER_MONTH=22000
OCRSPACE_QUOTA_PATH=./data/ocrspace-quota.json

# Optional verified 64-image acceptance inputs (only after confirming the archive fingerprint).
# OCRSPACE_64_ARCHIVE_PATH=C:/path/to/imgsHalf1.zip
# OCRSPACE_64_IMAGE_ROOT=C:/path/to/extracted/imgsHalf1

# Tesseract.js needs a local eng.traineddata file. Point to the installed tessdata folder;
# example Windows path (adjust to your local Tesseract installation):
# TESSERACT_LANG_PATH=C:/Program Files/Tesseract-OCR/tessdata
