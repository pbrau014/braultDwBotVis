{
  "name": "wows-yolo-tourney-discord-bot",
  "version": "2.5.0",
  "private": true,
  "description": "Hardened WoWS OCR battle reporter and 50-player YOLO Tourney bot with transactional local SQLite, public interactive controls, expanded workbook totals, and JSON/Discord recovery.",
  "main": "src/bot.js",
  "scripts": {
    "start": "node src/bot.js",
    "test": "node --test \"tests/*.test.js\"",
    "corpus:fetch": "node scripts/fetch-reference-corpus.js",
    "corpus:test": "node scripts/run-reference-regression.js",
    "test:four-images": "node scripts/run-four-screenshot-pipeline.js",
    "test:reported-screenshot": "node scripts/run-reported-screenshot-regression.js",
    "test:system": "node --test tests/full-system.test.js",
    "test:sqlite": "node --test tests/sqlite-store.test.js",
    "acceptance": "npm test && npm run test:reported-screenshot && npm run test:four-images && npm run test:additional-images",
    "test:tesseractjs": "node scripts/accept-tesseractjs.js",
    "test:ocr-watchdog": "node --test tests/ocr-watchdog.test.js tests/windows-process-cancel.test.js tests/damage-consensus.test.js",
    "test:additional-images": "node scripts/run-additional-screenshot-regression.js",
    "test:opencv": "node --test tests/opencv-field-isolation.test.js",
    "benchmark:paddleocr:offline": "node scripts/run-offline-paddleocr-benchmark.js",
    "summarize:ocr": "node scripts/summarize-ocr-acceptance.js",
    "summarize:multi-provider-accuracy": "node scripts/summarize-multi-provider-accuracy.js",
    "test:paddleocr-fallback": "node --test tests/paddleocr-field-fallback.test.js",
    "acceptance:paddleocr": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-paddleocr-integrated-acceptance.ps1",
    "test:discord-gateway-diagnostics": "node --test tests/discord-gateway-diagnostics.test.js",
    "test:discord-command-policy": "node --test tests/tournament-command-policy.test.js",
    "test:discord-preflight": "node --test tests/discord-gateway-diagnostics.test.js tests/tournament-command-policy.test.js tests/discord-test-preflight.test.js",
    "preflight:discord-test": "node scripts/preflight-discord-test.js",
    "test:multi-provider": "node --test tests/azure-document-intelligence.test.js tests/parallel-local-ocr.test.js",
    "smoke:multi-provider": "node scripts/run-multi-provider-smoke.js",
    "test:ocrspace": "node --test tests/ocrspace.test.js tests/ocrspace-prepass.test.js tests/ocrspace-pdf-first.test.js tests/ocrspace-exploratory-resume.test.js tests/ocrspace-pdf-text-layer.test.js tests/ocrspace-reconciliation.test.js tests/ocr-report-metadata.test.js tests/ocrspace-64-inventory.test.js tests/ocrspace-imagesF-21-ground-truth.test.js tests/ocrspace-imagesF-21-local-recovery.test.js tests/parallel-ocr-readers.test.js tests/ocrspace-imagesF-21-artifact-verifier.test.js",
    "test:ocr": "npm run test:multi-provider && npm run test:ocrspace && npm run test:ocr-sequence-checkpoint && npm run test:ocr-watchdog && npm run test:paddleocr-fallback",
    "test:ocr-sequence-checkpoint": "node --test tests/ocr-sequence-checkpoint.test.js tests/ocr-sequence-resume.test.js tests/gateA-resume.test.js",
    "test:desktop": "node --test tests/desktop-service.test.js tests/desktop-bridge.test.js tests/desktop-account-links.test.js tests/desktop-test-preflight.test.js tests/desktop-ui-contract.test.js",
    "preflight:desktop-test": "node scripts/preflight-desktop-test.js",
    "test:prelive": "npm run test:discord-preflight && npm run preflight:desktop-test && npm run test:desktop && npm run test:ocr",
    "test:persistence-recovery": "node scripts/run-persistence-recovery.js",
    "test:windows-native-ocr": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-windows-ocr-acceptance.ps1",
    "test:windows-release-gates": "npm run test:persistence-recovery && npm run test:windows-native-ocr",
    "test:ocrspace-imagesF-63": "node scripts/run-ocrspace-imagesF-63-exploratory.js",
    "evaluate:ocrspace-imagesF-21": "python scripts/evaluate-ocrspace-imagesF-63-ground-truth.py --inventory complete-ground-truth-21 --run-report testdata/ocrspace-imagesF-63-exploratory/ocrspace-imagesF-63-exploratory-report.json --ground-truth testdata/ground-truth/imagesF-63-working-ground-truth-v6.json --output testdata/ocrspace-imagesF-63-exploratory/posthoc-21-ground-truth-evaluation.json",
    "verify:ocrspace-imagesF-21-artifacts": "node scripts/verify-ocrspace-imagesF-21-artifacts.js --run-report testdata/ocrspace-imagesF-63-exploratory/ocrspace-imagesF-63-exploratory-report.json --ground-truth testdata/ground-truth/imagesF-63-working-ground-truth-v6.json --preflight-report testdata/ocr-acceptance/imagesF-63-preflight.json --fresh-preflight-report testdata/ocr-acceptance/fresh-imagesF-63-preflight.json --source-image-root testdata/imagesF-63 --artifact-root testdata/ocrspace-imagesF-63-exploratory --network-log testdata/ocr-acceptance/imagesF-63-blocked-network-attempts.log --workflow-file .github/workflows/dwbot-imagesF-63-exploratory.yml --output testdata/ocrspace-imagesF-63-exploratory/artifact-verification-21.json",
    "evaluate:ocrspace-gateB-19": "python scripts/evaluate-ocrspace-imagesF-63-ground-truth.py --inventory gate-b-complete-ground-truth-19 --run-report testdata/ocrspace-imagesF-63-exploratory/recovered-run-report-21.json --ground-truth testdata/ground-truth/imagesF-63-working-ground-truth-v6.json --artifact-verification-report testdata/ocrspace-imagesF-63-exploratory/artifact-verification-19.json --output testdata/ocrspace-imagesF-63-exploratory/posthoc-evaluation-19.json",
    "verify:ocrspace-imagesF-19-artifacts": "node scripts/verify-ocrspace-imagesF-21-artifacts.js --run-report testdata/ocrspace-imagesF-63-exploratory/recovered-run-report-21.json --ground-truth testdata/ground-truth/imagesF-63-working-ground-truth-v6.json --preflight-report testdata/ocr-acceptance/imagesF-63-preflight.json --fresh-preflight-report testdata/ocr-acceptance/fresh-imagesF-63-preflight.json --source-image-root testdata/imagesF-63 --artifact-root testdata/ocrspace-imagesF-63-exploratory --network-log testdata/ocr-acceptance/imagesF-63-blocked-network-attempts.log --recovery-network-log testdata/ocr-acceptance/local-reader-recovery-network.log --network-log-reconciliation testdata/ocr-acceptance/network-log-reconciliation.json --workflow-file .github/workflows/dwbot-imagesF-63-exploratory.yml --output testdata/ocrspace-imagesF-63-exploratory/artifact-verification-19.json",
    "evaluate:ocrspace-pdf-text-layer-19": "node scripts/evaluate-ocrspace-pdf-text-layer.js --run-report testdata/ocrspace-imagesF-63-exploratory/recovered-run-report-21.json --ground-truth testdata/ground-truth/imagesF-63-working-ground-truth-v6.json --artifact-root testdata/ocrspace-imagesF-63-exploratory --inventory gate-b-complete-ground-truth-19 --output testdata/ocrspace-imagesF-63-exploratory/pdf-text-layer-analysis-19.json"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "tesseract.js": "^6.0.1",
    "tesseract.js-core": "^6.0.0"
  },
  "allowScripts": {
    "tesseract.js@6.0.1": true
  }
}
